{
  "name": "Stretchly",
  "productName": "Stretchly Teams",
  "desktopName": "net.hovancik.Stretchly",
  "version": "1.0.0",
  "description": "The break time reminder app that pauses breaks during Microsoft Teams calls (fork of Stretchly)",
  "main": "app/main.js",
  "type": "module",
  "scripts": {
    "start": "electron .",
    "dev": "cross-env NODE_ENV=development electron . --trace-warnings --trace-deprecation --enable-logging --remote-debugging-port=9222",
    "postinstall": "electron-builder install-app-deps",
    "pack": "electron-builder build --dir",
    "dist": "electron-builder build",
    "test": "vitest run",
    "test-single": "vitest run $1",
    "coverage": "vitest run --coverage",
    "tdd": "vitest --watch test",
    "lint": "cross-env ./node_modules/.bin/standard",
    "prepublishOnly": "pinst --disable",
    "postpublish": "pinst --enable",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EliseDeBrie/stretchly-teams.git"
  },
  "keywords": [
    "Stretchly",
    "Teams",
    "break",
    "time",
    "reminder"
  ],
  "author": "Elise De Brie",
  "contributors": [
    "Jan Hovancik <jan@hovancik.net> (original Stretchly author)"
  ],
  "license": "BSD-2-Clause",
  "bugs": {
    "url": "https://github.com/EliseDeBrie/stretchly-teams/issues"
  },
  "homepage": "https://github.com/EliseDeBrie/stretchly-teams",
  "build": {
    "appId": "io.github.elisedebrie.stretchlyteams",
    "productName": "Stretchly Teams",
    "dmg": {
      "icon": "build/icon.icns",
      "iconSize": 128,
      "contents": [
        {
          "x": 355,
          "y": 125,
          "type": "link",
          "path": "/Applications"
        },
        {
          "x": 155,
          "y": 125,
          "type": "file"
        }
      ]
    },
    "mac": {
      "category": "public.app-category.healthcare-fitness",
      "identity": "-",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "extendInfo": {
        "LSBackgroundOnly": 1,
        "LSUIElement": 1
      }
    },
    "linux": {
      "category": "Utility",
      "syncDesktopName": true,
      "target": [
        "AppImage",
        "deb",
        "rpm",
        "freebsd",
        "pacman",
        "tar.xz",
        "apk"
      ],
      "asarUnpack": "node_modules/macos-notification-state/**"
    },
    "rpm": {
      "fpm": [
        "--rpm-rpmbuild-define",
        "_build_id_links none"
      ]
    },
    "appx": {
      "identityName": "33881JanHovancik.stretchly",
      "publisher": "CN=35004EDA-CCDD-4304-A014-784D754E043F",
      "publisherDisplayName": "Jan Hovancik",
      "applicationId": "Stretchly",
      "displayName": "Stretchly"
    },
    "win": {
      "target": [
        "nsis",
        "7z",
        "portable"
      ],
      "asarUnpack": [
        "node_modules/windows-notification-state/**",
        "node_modules/macos-notification-state/**"
      ]
    },
    "portable": {
      "artifactName": "${productName} Portable ${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "nsisWeb": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "snap": {
      "base": "core22"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "EliseDeBrie",
        "repo": "stretchly-teams",
        "releaseType": "prerelease"
      }
    ]
  },
  "standard": {
    "globals": [
      "it",
      "describe",
      "before",
      "after",
      "beforeEach",
      "afterEach",
      "Audio",
      "fetch",
      "Notification",
      "alert",
      "__electronLog"
    ]
  },
  "devDependencies": {
    "@vitest/coverage-istanbul": "^5.0.3",
    "cross-env": "^10.1.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.7",
    "husky": "^9.1.7",
    "jsdom": "^30.1.2",
    "rimraf": "^6.1.3",
    "standard": "^17.1.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@particle/dbus-next": "^0.11.4",
    "auto-launch": "^6.0.0-rc1",
    "dompurify": "^3.4.16",
    "electron-log": "^5.4.4",
    "electron-store": "^11.0.2",
    "humanize-duration": "^3.35.0",
    "i18next": "^26.3.6",
    "i18next-fs-backend": "^2.6.8",
    "luxon": "^3.7.2",
    "meeussunmoon": "^3.1.0",
    "node-desktop-idle-v2": "^1.1.26",
    "ps-list": "^9.0.0",
    "semver": "^7.8.5",
    "windows-focus-assist": "^1.4.0"
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true,
    "node-desktop-idle-v2@1.1.26": true,
    "windows-focus-assist@1.4.0": true,
    "usocket": true,
    "fsevents": true
  }
}
